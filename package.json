{
  "name": "sheil-ai",
  "version": "1.0.0",
  "description": "a modular ai cli that unifies multiple model providers with built-in rag, embeddings, pluggable tools, and mcp support.",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "chat": "tsx src/index.ts chat",
    "list": "tsx src/index.ts list-models",
    "search": "tsx src/index.ts search",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose down --rmi local -v",
    "db:migrate": "docker-compose up migrations",
    "ingest:remote": "tsx src/scripts/scrape-parse-ingest.ts"
  },
  "bin": {
    "sheil-ai": "./src/index.ts"
  },
  "keywords": [
    "ai",
    "cli",
    "rag",
    "embeddings",
    "tools",
    "mcp"
  ],
  "author": "muzammil_07",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.58",
    "@ai-sdk/google": "3.0.43",
    "@ai-sdk/mcp": "1.0.25",
    "@ai-sdk/openai": "3.0.41",
    "@ai-sdk/openai-compatible": "2.0.35",
    "@aws-sdk/client-s3": "3.879.0",
    "@modelcontextprotocol/sdk": "1.27.1",
    "ai": "6.0.116",
    "chalk": "5.6.0",
    "cheerio": "1.1.2",
    "commander": "14.0.0",
    "dotenv": "17.2.1",
    "google-sr": "6.0.0",
    "mathjs": "15.2.0",
    "node-fetch": "3.3.2",
    "pg": "8.16.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "5.2.2",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "eslint-flat-config-utils": "2.1.1",
    "jiti": "2.6.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
